  "cli": [
    {
      "name": "allow-project-decisions",
      "script": "slop-scan.py",
      "args": [
        "{cases}/project-decisions",
        "--scale",
        "0,1,2,6,12,18,24,36,48",
        "--allow",
        "tracked-caps",
        "--strict"
      ],
      "exit": 0,
      "contains": [
        "allowed by the project (--allow): tracked-caps ×1",
        "nothing found"
      ]
    },
    {
      "name": "default-scale-flags-base-6",
      "script": "slop-scan.py",
      "args": [
        "{cases}/project-decisions",
        "--strict"
      ],
      "exit": 1,
      "contains": [
        "off the scale",
        "tracked all-caps"
      ]
    },
    {
      "name": "allow-refuses-contrast",
      "script": "unslop-score.py",
      "args": [
        "{cases}/project-decisions",
        "--allow",
        "contrast"
      ],
      "exit": 1,
      "contains": [
        "can't include contrast"
      ]
    },
    {
      "name": "allow-refuses-claims",
      "script": "slop-scan.py",
      "args": [
        "{cases}/project-decisions",
